{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "proposal-deviation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "affected_unit": {
      "type": "string",
      "minLength": 1
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1
    },
    "required_change": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "reason",
    "affected_unit",
    "expected_behavior",
    "required_change"
  ]
}
